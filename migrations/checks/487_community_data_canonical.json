{
  "migration": "487_community_data_canonical.sql",
  "summary": "Canonical community data (Issue #15): evidence-first properties / parties / relationships beside the legacy tables. Provider-scoped immutable source identities (parties found only by identity, never by name / email / phone / address), ownership / co-ownership / prior ownership with nullable dates + basis + observed_as_of (unknown is a state), occupancy separate from ownership (no inferred basis; co-tenants), leases as documents, attributed addresses / contact methods, first-class evidence. One SECURITY DEFINER write path (cd_apply) validates the whole proposal and runs in one transaction; idempotent by (community, key) + proposal hash. Tables SELECT-only for service_role. No existing row changes.",
  "requires": [
    "485_onboarding_operator.sql"
  ],
  "preflight": [
    {
      "name": "canonical tables do not exist yet",
      "sql": "SELECT count(*)::int FROM information_schema.tables WHERE table_schema = 'public' AND table_name LIKE 'cd\\_%'",
      "expect": 0
    },
    {
      "name": "properties carry community_id",
      "sql": "SELECT count(*)::int FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'properties' AND column_name = 'community_id'",
      "expect": 1
    }
  ],
  "expected_changes": [
    "Creates 11 cd_* tables (changes, source documents, parties, party / property source identities, ownerships, leases, occupancies, addresses, contact methods, evidence) with indexes and append-only / end-only triggers.",
    "Creates cd_apply (the single write path), cd_apply_change, cd_record_result, cd_why and guard functions; service_role may SELECT the tables and EXECUTE cd_apply / cd_why only.",
    "No row changes in any existing table."
  ],
